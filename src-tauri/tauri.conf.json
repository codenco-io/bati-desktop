{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bati",
  "version": "0.1.2",
  "identifier": "io.codenco.bati",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src https://codenco.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "CodeN'Co",
    "copyright": "© 2026 CodeN'Co",
    "category": "Business",
    "shortDescription": "Bati, l'espace des pros",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/cote.bmp",
        "headerImage": "nsis/bandeau.bmp",
        "uninstallerHeaderImage": "nsis/bandeau.bmp",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/fond.png",
        "windowSize": {
          "width": 660,
          "height": 360
        },
        "appPosition": {
          "x": 165,
          "y": 195
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 195
        }
      }
    }
  }
}

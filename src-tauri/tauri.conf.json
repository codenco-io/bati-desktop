{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bati",
  "version": "0.1.0",
  "identifier": "io.codenco.bati",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src https://codenco.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "CodeN'Co",
    "copyright": "© 2026 CodeN'Co",
    "category": "Business",
    "shortDescription": "Bati, l'espace des pros",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
